<?xml version="1.0" encoding="utf-8"?>
<!--
  상태바용 프로젝터 실루엣. 흰색/투명 모노크롬 — 시스템이 자동 tint.
  24x24 에서 원본 프로젝터 요소를 간소화해 유지.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 천장 레일 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,3 L19,3 L19,4 L5,4 Z" />
    <!-- 마운트 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.5,4 L13.5,4 L13.5,6.5 L10.5,6.5 Z" />
    <!-- 몸체 + 렌즈 (evenOdd 로 렌즈를 뚫는다) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2,6.5 L22,6.5 L22,17 L2,17 Z
                         M5.5,11.75 A2.5,2.5 0 1 0 10.5,11.75 A2.5,2.5 0 1 0 5.5,11.75 Z" />
    <!-- 받침 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3.5,17 L20.5,17 L20.5,20 L3.5,20 Z" />
</vector>
